---
const title = 'PULSE｜植物性プロテイン — からだに、まっすぐ効く一杯を。';
const description = 'えんどう豆と玄米のたんぱく質を、おいしく、毎日。抹茶・カカオ・ほうじ茶の3フレーバー。※ポートフォリオ用の架空ブランドのデモサイトです。';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#CFF56A" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PULSE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <style is:global>

body{margin:0;background:#F3F3EF}
a{color:#121212}a:hover{color:#3D3D3D}
@keyframes pl-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.pl-track{animation:pl-marquee 30s linear infinite}
.pl-btn{transition:transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease}
.pl-btn:hover{transform:translate(-2px,-2px);box-shadow:4px 4px 0 #121212}
.pl-arrow{transition:transform .25s cubic-bezier(.2,.8,.2,1)}
.pl-btn:hover .pl-arrow{transform:translateX(4px)}
.pl-cta{position:relative;overflow:hidden}
.pl-cta::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg);animation:pl-shine 3.6s ease-in-out infinite}
@keyframes pl-shine{0%,70%{left:-60%}100%{left:130%}}
@media (max-width: 760px){.pl-hide-sp{display:none !important}.pl-full-sp{max-width:100% !important}}
@media (prefers-reduced-motion: reduce){.pl-cta::after{animation:none;display:none}}
.pl-tile{transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.pl-tile:hover{transform:scale(1.015)}
.pl-chip{cursor:pointer;transition:background .2s ease, color .2s ease}
.pl-logo svg{transition:transform .4s cubic-bezier(.2,.8,.2,1)}
.pl-logo:hover svg{transform:rotate(-20deg) scale(1.06) !important}
.pl-nav{transition:background .25s ease, color .25s ease, transform .25s cubic-bezier(.2,.8,.2,1)}
.pl-nav:hover{background:#121212 !important;color:#CFF56A !important;transform:translateY(-2px) rotate(-2deg)}
.pl-faq summary{list-style:none;cursor:pointer}
.pl-faq summary::-webkit-details-marker{display:none}
.pl-faq[open] .pl-x{transform:rotate(180deg)}
@media (prefers-reduced-motion: reduce){.pl-track{animation:none}}

html{scroll-behavior:smooth}
img{max-width:none}
.pl-sp-only{display:none}
/* ===== Tablet (761px - 1100px) ===== */
@media (min-width: 761px) and (max-width: 1100px){
  .pl-hero .pl-hide-sp{display:none !important}
  .pl-sp-only{display:flex !important}
  .pl-hero{padding:0 0 40px !important;gap:0 !important;display:flex !important;flex-direction:column}
  .pl-hero-panel{order:-1;border-radius:0 0 40px 40px !important;min-height:clamp(740px, 92vw, 860px) !important;padding:28px 32px 32px !important;justify-content:flex-start !important;gap:20px !important;overflow:hidden}
  .pl-sp-only > p:nth-of-type(2){font-size:clamp(88px, 12vw, 124px) !important}
  .pl-flavor-pick{flex-direction:row !important;align-items:center !important;gap:12px !important;flex-wrap:wrap}
  .pl-flavor-pick button[aria-pressed="true"]{background:#121212 !important;color:#CFF56A !important;border-color:#121212 !important}
  .pl-flavor-pick button[aria-pressed="false"]{background:rgba(255,255,255,0.8) !important;color:#121212 !important;border-color:rgba(18,18,18,0.25) !important}
  .pl-hero-woman{height:76% !important;max-width:58% !important;right:3% !important}
  .pl-hero-powder{top:auto !important;bottom:26% !important;right:-4% !important;width:54% !important;opacity:.5 !important}
  .pl-pouch-wrap{position:absolute !important;left:32px;bottom:32px;flex:none !important;min-height:0 !important}
  .pl-hero-ing{width:170px !important;left:120px !important}
  .pl-hero-card{margin:20px 24px 0 !important;min-height:0 !important;padding:32px 36px !important;gap:24px !important;box-shadow:none !important}
  .pl-hero-card > div:not(.pl-hide-sp){flex-direction:row !important;justify-content:space-between;align-items:center;gap:32px !important}
  .pl-hero-card > div:not(.pl-hide-sp) > p{max-width:44%}
  .pl-flavor-card p:last-child{font-size:13px !important}
  .pl-grid3{grid-template-columns:repeat(3, minmax(0, 1fr)) !important;gap:12px !important}
  .pl-why-card{min-height:0 !important;padding:20px 18px 22px !important;gap:12px !important;border-radius:22px !important}
  .pl-why-label{display:none !important}
  .pl-why-img{width:84px !important;right:8px !important;top:12px !important;bottom:auto !important;transform:rotate(-6deg) !important}
  .pl-why-text{max-width:100% !important}
  .pl-why-text h3{font-size:19px !important}
  .pl-why-card > div[style*="#ECECE6"]{max-width:100% !important;margin-top:36px}
  .pl-why-card > div[style*="#ECECE6"] p{font-size:13px !important}
  .pl-scene-photo{height:160px !important}
  .pl-grid3 article h3{font-size:17px !important}
  .pl-flavor-card{min-height:260px !important;padding:20px !important;border-radius:22px !important}
  .pl-flavor-name{font-size:clamp(30px, 4.2vw, 42px) !important}
  .pl-flavor-ing{width:62% !important;right:-10% !important}
  .pl-grid3 > li{padding:18px !important;gap:14px !important;border-radius:22px !important}
  .pl-step-media{height:180px !important}
  .pl-step-circle{width:140px !important;height:140px !important}
  .pl-step-img{max-height:170px !important}
  .pl-step-num{font-size:56px !important}
  .pl-voice{padding:20px !important;gap:12px !important;border-radius:22px !important}
  .pl-voice > p{font-size:16px !important}
  .pl-voice blockquote{font-size:13px !important}
  .pl-plan-box{grid-template-columns:minmax(0, 1fr) minmax(0, 1.1fr) !important;gap:28px !important;padding:36px 28px !important;align-items:center !important}
  .pl-plan-visual{height:230px !important;transform:scale(.78);transform-origin:left bottom;width:128%;margin-top:0 !important}
}

.pl-sp-br{display:none}
/* ===== SP only ===== */
@media (max-width: 760px){
  .pl-header-inner{flex-wrap:nowrap !important;padding:14px 16px !important;gap:12px !important}
  .pl-head-cta{padding:10px 16px !important;font-size:12px !important}
  .pl-head-badge{display:none !important}
  .pl-hero{padding:12px 12px 40px !important;gap:12px !important}
  .pl-hero-card{min-height:0 !important;padding:28px 22px 30px !important;gap:26px !important;border-radius:26px !important}
  .pl-hero-panel{min-height:600px !important;padding:22px !important;border-radius:26px !important;overflow:hidden}
  .pl-hero-woman{height:94% !important;max-width:88% !important;right:-10% !important}
  .pl-hero-powder{left:auto !important;right:-6% !important;top:14% !important;width:78% !important}
  .pl-pouch-wrap{min-height:0 !important;padding-left:0 !important}
  .pl-pouch{transform:rotate(-6deg) scale(.74) !important;transform-origin:left bottom;margin-bottom:6px !important}
  .pl-hero-ing{width:140px !important;left:72px !important;bottom:-4px !important}
  .pl-marquee{transform:none !important;margin:0 !important;padding:14px 0 !important}
  .pl-track-text{font-size:24px !important;gap:28px !important}
  .pl-flavor-card{min-height:0 !important;padding:24px !important;gap:16px !important}
  .pl-flavor-ing{width:48% !important;right:-6% !important;top:-6% !important}
  .pl-sticky{bottom:0 !important;padding:0 !important;transition:transform .35s ease, opacity .35s ease}
  .pl-sticky.is-hidden{transform:translateY(110%);opacity:0;pointer-events:none}
  .pl-sticky-inner{border-radius:20px 20px 0 0 !important;max-width:none !important;padding:12px 14px calc(12px + env(safe-area-inset-bottom)) 18px !important;box-shadow:0 -8px 30px rgba(18,18,18,0.25) !important}
  .pl-sticky-price{flex-direction:column;align-items:flex-start !important;gap:2px !important;font-size:11px !important}
  .pl-sticky-sub{display:none !important}
  .pl-hero-price{font-size:34px !important}
  .pl-sp-only{display:flex !important}
  .pl-grid3{grid-template-columns:1fr !important}
  .pl-sp-br{display:inline}
  .pl-hero-powder{opacity:.45 !important}
  .pl-why-card{min-height:0 !important;padding:22px 20px 24px !important;gap:14px !important;border-radius:24px !important}
  .pl-why-label{display:none !important}
  .pl-why-img{width:100px !important;right:10px !important;top:14px !important;bottom:auto !important;transform:rotate(-6deg) !important}
  .pl-why-text{max-width:100% !important}
  .pl-why-card > div[style*="#ECECE6"]{max-width:70% !important}

  .pl-hero{padding:0 0 32px !important;gap:0 !important;display:flex !important;flex-direction:column}
  .pl-hero-panel{order:-1;border-radius:0 0 32px 32px !important;min-height:clamp(560px, 150vw, 650px) !important;padding:20px 18px 24px !important;justify-content:flex-start !important;gap:18px !important}
  .pl-flavor-pick{flex-direction:row !important;align-items:center !important;gap:10px !important;flex-wrap:wrap}
  .pl-flavor-pick > span{font-size:10px !important}
  .pl-hero-card{margin:12px 12px 0 !important;z-index:4 !important;box-shadow:none !important;gap:22px !important;padding:26px 22px 28px !important}
  .pl-hero-woman{height:72% !important;max-width:84% !important;right:-6% !important}
  .pl-hero-powder{top:auto !important;bottom:30% !important;right:-14% !important;width:74% !important}
  .pl-flavor-pick button[aria-pressed="true"]{background:#121212 !important;color:#CFF56A !important;border-color:#121212 !important}
  .pl-flavor-pick button[aria-pressed="false"]{background:rgba(255,255,255,0.8) !important;color:#121212 !important;border-color:rgba(18,18,18,0.25) !important}
  .pl-pouch-wrap{position:absolute !important;left:10px;bottom:20px;flex:none !important}

}

    </style>
  </head>
  <body>


<div data-root style="--f-color: #B5D38A; --f-ink: #121212; --f-imgW: 300px; --f-imgLeft: 120px; font-family: 'Noto Sans JP', 'Hiragino Sans', sans-serif; color: #121212; background: #F3F3EF; font-size: 15px; line-height: 1.8; overflow-x: clip">

  <!-- Header -->
  <header>
    <div class="pl-header-inner" style="max-width: 1320px; margin: 0 auto; padding: 18px clamp(16px, 4vw, 48px); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap">
      <a class="pl-logo" href="#top" aria-label="PULSE トップへ" style="text-decoration: none; color: #121212; display: flex; align-items: center; gap: 10px"><svg aria-hidden="true" width="46" height="46" viewBox="0 0 48 48" style="flex-shrink: 0; transform: rotate(-8deg)"><circle cx="24" cy="24" r="22" fill="#CFF56A" stroke="#121212" stroke-width="2.5"/><path d="M7 26h8l3.5-8 6 17 4.5-12 2.5 5H41" fill="none" stroke="#121212" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M31 15c1.5-5 6-7.5 10.5-7.5 0 4.5-2.5 9-7.5 10.5-1.3.4-2.6.3-3.7-.1.1-1 .4-2 .7-2.9z" fill="#121212"/></svg><span style="display: flex; flex-direction: column; gap: 3px"><span style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 30px; line-height: 0.85; letter-spacing: -0.05em">PULSE<span style="color: #9A9A92">.</span></span><span style="font-size: 8px; font-weight: 700; letter-spacing: 0.22em; line-height: 1">PLANT PROTEIN</span></span></a>
      <nav class="pl-hide-sp" aria-label="メイン" style="display: flex; gap: 6px; flex-wrap: wrap; font-size: 13px; font-weight: 500">
        <a class="pl-nav" href="#why" style="padding: 10px 16px; border-radius: 999px; text-decoration: none; color: #121212; background: #E6E6E0">特長</a>
        <a class="pl-nav" href="#flavors" style="padding: 10px 16px; border-radius: 999px; text-decoration: none; color: #121212; background: #E6E6E0">フレーバー</a>
        <a class="pl-nav" href="#plan" style="padding: 10px 16px; border-radius: 999px; text-decoration: none; color: #121212; background: #E6E6E0">価格</a>
        <a class="pl-nav" href="#faq" style="padding: 10px 16px; border-radius: 999px; text-decoration: none; color: #121212; background: #E6E6E0">FAQ</a>
      </nav>
      <a class="pl-btn pl-head-cta" href="#plan" style="background: #121212; color: #F3F3EF; font-weight: 700; font-size: 13px; padding: 12px 22px; border-radius: 999px; text-decoration: none; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 8px">¥1,980で試す<span class="pl-head-badge" style="font-size: 11px; padding: 2px 8px; border-radius: 999px; background: #CFF56A; color: #121212">60%OFF</span></a>
    </div>
  </header>

  <!-- Hero -->
  <section id="top" class="pl-hero" style="max-width: 1320px; margin: 0 auto; padding: clamp(56px, 7vw, 96px) clamp(16px, 4vw, 48px) clamp(48px, 6vw, 80px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(520px, 100%), 1fr)); gap: 16px">
    <div class="pl-hero-card" style="position: relative; z-index: 2; background: #FFFFFF; border-radius: 32px; padding: clamp(32px, 4vw, 56px); display: flex; flex-direction: column; justify-content: space-between; gap: 40px; min-height: 640px; box-sizing: border-box">
      <img class="pl-hide-sp" src="/images/leaves.webp" alt="" aria-hidden="true" style="position: absolute; right: -70px; bottom: -56px; width: 250px; transform: rotate(-18deg); filter: drop-shadow(0 16px 16px rgba(18,18,18,0.22)); pointer-events: none">
      <img class="pl-hide-sp" src="/images/leaf.webp" alt="" aria-hidden="true" style="position: absolute; right: 18%; top: -34px; width: 110px; transform: rotate(32deg); filter: drop-shadow(0 10px 12px rgba(18,18,18,0.2)); pointer-events: none">
      <div class="pl-hide-sp" style="display: flex; gap: 8px; flex-wrap: wrap">
        <span style="font-size: 12px; font-weight: 700; padding: 6px 14px; border-radius: 999px; background: #CFF56A">植物性プロテイン</span>
        <span style="font-size: 12px; font-weight: 500; padding: 6px 14px; border-radius: 999px; border: 1px solid #121212">人工甘味料不使用</span>
      </div>
      <h1 class="pl-hide-sp" style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(72px, 9.4vw, 148px); line-height: 0.86; letter-spacing: -0.055em">PLANT<br>POWER<span style="color: #9A9A92">.</span></h1>
      <div style="display: flex; flex-direction: column; gap: 24px">
        <p style="margin: 0; font-size: clamp(18px, 1.6vw, 22px); font-weight: 700; line-height: 1.6">からだに、まっすぐ効く一杯を。<br><span style="font-weight: 400; color: #4A4A45; font-size: 15px">えんどう豆と玄米のたんぱく質を、おいしく、毎日。</span></p>
        <div style="display: flex; flex-direction: column; gap: 12px; align-items: flex-start">
          <p style="margin: 0; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap"><span style="font-size: 13px; font-weight: 700">定期便の初回</span><s style="font-size: 15px; color: #6A6A64">通常 ¥4,980</s><span class="pl-hero-price" style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 40px; line-height: 1; letter-spacing: -0.03em">¥1,980</span><span style="font-size: 12px; font-weight: 900; padding: 4px 10px; border-radius: 999px; background: #121212; color: #CFF56A">60%OFF</span></p>
          <a class="pl-btn pl-cta" href="#plan" style="background: #CFF56A; color: #121212; border: 2px solid #121212; box-shadow: 4px 4px 0 #121212; font-weight: 900; font-size: clamp(15px, 1.4vw, 18px); padding: 20px clamp(22px, 3vw, 36px); border-radius: 999px; text-decoration: none; white-space: nowrap; display: inline-flex; align-items: center; gap: 12px; min-height: 44px; box-sizing: border-box">初回 ¥1,980 で試してみる<svg class="pl-arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9h11M10 4.5L14.5 9 10 13.5"/></svg></a>
          <ul style="margin: 0; padding: 0; list-style: none; display: flex; gap: 6px 14px; flex-wrap: wrap; font-size: 13px; font-weight: 700; color: #2E2E2A"><li style="display: inline-flex; align-items: center; gap: 5px"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>送料無料</li><li style="display: inline-flex; align-items: center; gap: 5px"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>いつでも解約OK</li><li style="display: inline-flex; align-items: center; gap: 5px"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>回数しばりなし</li></ul>
        </div>
      </div>
    </div>
    <div class="pl-hero-panel" style="position: relative; background: var(--f-color); color: var(--f-ink); border-radius: 32px; padding: clamp(28px, 3vw, 40px); display: flex; flex-direction: column; justify-content: space-between; gap: 24px; min-height: 640px; box-sizing: border-box; transition: background .4s ease, color .4s ease">
      <div class="pl-hide-sp" aria-hidden="true" style="position: absolute; left: 0; right: 0; top: 14%; text-align: right; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(90px, 14vw, 220px); line-height: 0.8; letter-spacing: -0.06em; opacity: 0.14; white-space: nowrap; overflow: hidden; border-radius: 32px"><span data-f="name">MATCHA</span></div>
      <img class="pl-hero-powder" src="/images/powder3.webp" alt="" aria-hidden="true" style="position: absolute; left: 22%; top: 4%; width: 62%; opacity: 0.95; z-index: 0; transform: rotate(-12deg); pointer-events: none">
      <img class="pl-hero-woman" src="/images/hero-woman.webp" alt="シェイカーを手に笑顔の女性" style="position: absolute; right: 0; bottom: 0; height: 112%; width: auto; max-width: 74%; object-fit: contain; object-position: right bottom; z-index: 1; filter: drop-shadow(-18px 24px 30px rgba(18,18,18,0.18))">
      <div class="pl-sp-only" style="position: relative; z-index: 3; flex-direction: column; gap: 14px">
        <p style="margin: 0; display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; font-weight: 900; letter-spacing: 0.04em; color: var(--f-ink)"><span style="display: inline-flex; align-items: center; gap: 4px"><svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>植物性プロテイン</span><span style="display: inline-flex; align-items: center; gap: 4px"><svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>人工甘味料不使用</span></p>
        <p style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 19vw; line-height: 0.84; letter-spacing: -0.06em; color: var(--f-ink); transition: color .4s ease">PLANT<br>POWER<span style="color: #CFF56A; -webkit-text-stroke: 1.5px #121212">.</span></p>
      </div>
      <div class="pl-flavor-pick" style="position: relative; z-index: 3; display: flex; flex-direction: column; gap: 12px; align-items: flex-start">
        <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.12em">FLAVOR — <span data-f="no">1</span>/03</span>
        <div role="group" aria-label="フレーバーを選ぶ" style="display: flex; gap: 6px; flex-wrap: wrap">
          
            <button class="pl-chip" type="button" aria-pressed="true" style="font-family: inherit; font-size: 12px; font-weight: 700; padding: 10px 16px; min-height: 44px; border-radius: 999px; border: 1.5px solid var(--f-ink); background: var(--f-ink); color: var(--f-color)">抹茶</button>
          
            <button class="pl-chip" type="button" aria-pressed="false" style="font-family: inherit; font-size: 12px; font-weight: 700; padding: 10px 16px; min-height: 44px; border-radius: 999px; border: 1.5px solid var(--f-ink); background: transparent; color: var(--f-ink)">カカオ</button>
          
            <button class="pl-chip" type="button" aria-pressed="false" style="font-family: inherit; font-size: 12px; font-weight: 700; padding: 10px 16px; min-height: 44px; border-radius: 999px; border: 1.5px solid var(--f-ink); background: transparent; color: var(--f-ink)">ほうじ茶</button>
          
        </div>
      </div>
