    <script define:vars={{ F: [{"no": 1, "name": "MATCHA", "jp": "抹茶", "color": "#B5D38A", "ink": "#121212", "img": "/images/matcha.webp", "alt": "木のスプーンにのった抹茶パウダー", "imgW": "300px", "imgLeft": "120px", "note": "宇治抹茶のほろ苦さ。\n豆乳で割ると、抹茶ラテに。"}, {"no": 2, "name": "CACAO", "jp": "カカオ", "color": "#5C3F33", "ink": "#F3F3EF", "img": "/images/cacao.webp", "alt": "カカオ豆", "imgW": "200px", "imgLeft": "150px", "note": "カカオ豆の香ばしさ。\n甘さひかえめの、大人のココア。"}, {"no": 3, "name": "HOJICHA", "jp": "ほうじ茶", "color": "#D9A877", "ink": "#121212", "img": "/images/hojicha.webp", "alt": "木皿にのったほうじ茶の茶葉", "imgW": "250px", "imgLeft": "130px", "note": "焙じた茶葉の香り。\n夜のリラックスタイムにも。"}], P: {"sub": {"planName": "定期便（30杯分 / 月）", "price": "¥1,980", "priceNote": "税込・初回（2回目以降 ¥3,980）", "ctaLabel": "定期便を ¥1,980 ではじめる", "ctaNote": "回数しばりなし。マイページからいつでも解約・スキップOK", "perks": ["2回目以降も 20%OFF", "フレーバーは毎回変更OK", "送料無料・いつでも解約OK"]}, "once": {"planName": "単品（30杯分）", "price": "¥4,980", "priceNote": "税込", "ctaLabel": "単品で購入する", "ctaNote": "まずは1袋から。気に入ったら定期便への切り替えもかんたん", "perks": ["まずは1袋だけ試したい方に", "送料 ¥660"]}} }}>
      const sticky = document.querySelector('.pl-sticky');
      const hero = document.getElementById('top');
      if (sticky && hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => sticky.classList.toggle('is-hidden', e.isIntersecting), { threshold: 0.15 }).observe(hero);
      }
      const root = document.querySelector('[data-root]');
      const chips = [...document.querySelectorAll('[aria-label="フレーバーを選ぶ"] button')];
      function setFlavor(i) {
        const f = F[i];
        root.style.setProperty('--f-color', f.color);
        root.style.setProperty('--f-ink', f.ink);
        root.style.setProperty('--f-imgW', f.imgW);
        root.style.setProperty('--f-imgLeft', f.imgLeft);
        for (const k of ['name', 'jp', 'note', 'no']) document.querySelectorAll('[data-f="' + k + '"]').forEach((e) => (e.textContent = String(f[k])));
        const img = document.querySelector('[data-fimg]');
        if (img) { img.src = f.img; img.alt = f.alt; }
        chips.forEach((c, j) => {
          const on = j === i;
          c.setAttribute('aria-pressed', String(on));
          c.style.background = on ? 'var(--f-ink)' : 'transparent';
          c.style.color = on ? 'var(--f-color)' : 'var(--f-ink)';
        });
      }
      chips.forEach((c, i) => c.addEventListener('click', () => setFlavor(i)));

      const planBtns = [...document.querySelectorAll('[aria-label="購入方法"] button')];
      const perksUl = document.querySelector('[data-perks]');
      const perkTpl = perksUl ? perksUl.querySelector('li').cloneNode(true) : null;
      function setPlan(key) {
        const p = P[key];
        for (const k of ['planName', 'price', 'priceNote', 'ctaLabel', 'ctaNote']) document.querySelectorAll('[data-p="' + k + '"]').forEach((e) => (e.textContent = p[k]));
        document.querySelectorAll('[data-sub-only]').forEach((e) => (e.style.display = key === 'sub' ? 'contents' : 'none'));
        if (perksUl && perkTpl) {
          perksUl.replaceChildren(...p.perks.map((t) => { const li = perkTpl.cloneNode(true); li.lastChild.textContent = t; return li; }));
        }
        planBtns.forEach((b, j) => {
          const on = (j === 0) === (key === 'sub');
          b.setAttribute('aria-pressed', String(on));
          b.style.background = on ? '#121212' : 'transparent';
          b.style.color = on ? '#F3F3EF' : '#121212';
        });
      }
      planBtns.forEach((b, j) => b.addEventListener('click', () => setPlan(j === 0 ? 'sub' : 'once')));
    </script>
  </body>
